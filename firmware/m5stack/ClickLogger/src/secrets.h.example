// Wi-Fi credentials used ONLY once at boot to sync the RTC via NTP.
// Copy this file to secrets.h and fill in your own values.
// secrets.h is gitignored — never commit real credentials.

#pragma once

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Timezone: seconds offset from UTC, plus DST offset in seconds.
// Example: US Eastern (EST/EDT): -5*3600, 3600
#define GMT_OFFSET_SEC     0
#define DAYLIGHT_OFFSET_SEC 0

// Periodic push target: every PUSH_INTERVAL_MS, the board briefly wakes
// WiFi, POSTs the current /clicks.csv log to this host/port/path, clears
// the log on success, then turns WiFi back off.
#define PUSH_HOST "192.168.1.100"
#define PUSH_PORT 8090
#define PUSH_PATH "/click"
#define PUSH_PATH_SNIPPETS "/snippets"
#define PUSH_INTERVAL_MS (5UL * 60UL * 1000UL)  // 5 minutes
